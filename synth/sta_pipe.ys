# Logic-only static timing estimate for core B (make sta).  Not timing sign-off:
# cell delays from Yosys' 7-series models, no placement or routing delay,
# distributed RAM replaced by flip-flops so every path has timing arcs.
read_verilog -defer -sv -Irtl rtl/decoder.sv rtl/alu.sv rtl/regfile.sv rtl/lsu_align.sv rtl/csr_file.sv rtl/bpred.sv rtl/divider.sv rtl/mem_arbiter.sv rtl/icache.sv rtl/dcache.sv rtl/core_pipe.sv synth/top_pipe.sv
synth_xilinx -family xc7 -top top_pipe -flatten -nolutram
read_verilog -lib -specify +/xilinx/cells_sim.v
tee -q -o build/synth/pipe/sta.txt sta
